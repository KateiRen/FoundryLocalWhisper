<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FoundryLocalWhisper</AssemblyName>
    <RootNamespace>FoundryLocalWhisper</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned rather than floating so the published latency comparison stays reproducible. -->
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="1.2.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.15" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\mic.png" Link="assets\mic.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\mic_rec.png" Link="assets\mic_rec.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
